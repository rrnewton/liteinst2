#!/usr/bin/env python3
"""Bound and retain the direct parent of one exact-revision validation phase."""
import hashlib, json, os, signal, subprocess, sys, time
from pathlib import Path
if sys.flags.optimize:
    raise SystemExit('assertions required')
repo = Path.cwd().resolve()
phase = sys.argv[1]
assert phase in ('targeted-profiler', 'targeted-doc', 'targeted', 'native-build', 'required', 'serial', 'parallel-library', 'parallel-prefixed', 'parallel-neighbor')
revision = '16212e9ab00a18ce003a305f7265bce8633e1c0e'
source_hash = '67cc6d06f28a319bf6bddc1e0504fdada7468b25198d6198438f7d243d9166dd'
if revision is None or source_hash is None:
    raise SystemExit('exact source activation required')
source = repo / 'ignored/a4/code-point-opt2-source-v1/validate.py'
assert hashlib.sha256(source.read_bytes()).hexdigest() == source_hash
base = repo / 'ignored/a4/code-point-opt2-validation-v1'
base.mkdir(exist_ok=True)
out = base / phase
launch = base / (phase + '-launch')
launch.mkdir()
argv = ['/usr/bin/python3.9', '-B', str(source), '--repo', str(repo), '--output', str(out), '--toolchain', '${TOOLCHAIN}', '--user-home', '${USER_HOME}', '--cargo-home', '${CARGO_HOME}', '--phase', phase]
env = {'LC_ALL': 'C.UTF-8', 'PATH': '/usr/bin:/bin', 'PYTHONDONTWRITEBYTECODE': '1'}
bound = 1060 if phase == 'required' else 420 if phase.startswith('parallel-') else 240
def write(name, obj):
    with (launch / name).open('x') as stream:
        json.dump(obj, stream, indent=2, sort_keys=True)
        stream.write('\n')
write('command.json', dict(argv=argv, cwd=str(repo), env=env, parent_timeout_seconds=bound, parent_cleanup_seconds=10, source_revision=revision, source_sha256=source_hash, parent_source_sha256=hashlib.sha256(Path(__file__).read_bytes()).hexdigest()))
start = time.monotonic()
child = None
error = None
try:
    with (launch / 'stdout.txt').open('xb') as stdout, (launch / 'stderr.txt').open('xb') as stderr:
        child = subprocess.Popen(argv, cwd=repo, env=env, stdin=subprocess.DEVNULL, stdout=stdout, stderr=stderr, start_new_session=True)
        try:
            write('started.json', dict(pid=child.pid, monotonic=start))
            child.wait(timeout=bound)
        except BaseException as failure:
            error = type(failure).__name__
            if child.poll() is None:
                try:
                    os.killpg(child.pid, signal.SIGKILL)
                except ProcessLookupError:
                    pass
            try:
                child.wait(timeout=10)
            except subprocess.TimeoutExpired:
                error += ':CLEANUP_WAIT_EXPIRED'
                raise
            raise
finally:
    if child is not None:
        closed = dict(exit=child.returncode, parent_error=error, parent_wait_returned=child.returncode is not None, pid=child.pid, seconds=time.monotonic() - start, stdout_sha256=hashlib.sha256((launch / 'stdout.txt').read_bytes()).hexdigest(), stderr_sha256=hashlib.sha256((launch / 'stderr.txt').read_bytes()).hexdigest())
        write('closed.json', closed)
assert child is not None
print(json.dumps(closed, sort_keys=True), flush=True)
print((launch / 'stdout.txt').read_text()[-12000:], flush=True)
print((launch / 'stderr.txt').read_text()[-12000:], flush=True)
raise SystemExit(0 if child.returncode == 0 and error is None else 1)
