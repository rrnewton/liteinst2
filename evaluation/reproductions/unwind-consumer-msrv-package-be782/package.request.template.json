{
  "argv": [
    "${TOOLCHAIN}/bin/cargo",
    "package",
    "-p",
    "liteinst2",
    "--list",
    "--offline",
    "--locked",
    "--allow-dirty"
  ],
  "cpu_seconds": 20,
  "cwd": "${REPO}",
  "env": {
    "CARGO_BUILD_JOBS": "4",
    "CARGO_HOME": "${CARGO_HOME}",
    "CARGO_INCREMENTAL": "0",
    "CARGO_NET_OFFLINE": "true",
    "CARGO_TARGET_DIR": "${REPO}/target",
    "HOME": "${USER_HOME}",
    "LC_ALL": "C",
    "PATH": "${TOOLCHAIN}/bin:/usr/bin:/bin",
    "PYTHONDONTWRITEBYTECODE": "1",
    "RUSTC": "${TOOLCHAIN}/bin/rustc",
    "RUSTFLAGS": "-Dwarnings -Wmissing-docs -Funsafe-op-in-unsafe-fn -Ccodegen-units=1",
    "TMPDIR": "${RAW}/tmp"
  },
  "file_bytes": 16777216,
  "stderr": "${RAW}/package.stderr",
  "stdout": "${RAW}/package.stdout",
  "wall_seconds": 30
}
