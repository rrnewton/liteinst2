{
  "argv": [
    "${TOOLCHAIN}/bin/cargo",
    "build",
    "--manifest-path",
    "${WORKSPACE}/Cargo.toml",
    "-p",
    "rapid-profiler",
    "--bin",
    "frontend-native-oracle",
    "--offline",
    "--locked",
    "--message-format=json"
  ],
  "cpu_seconds": 60,
  "cwd": "${WORKSPACE}",
  "env": {
    "CARGO_BUILD_JOBS": "4",
    "CARGO_HOME": "${CARGO_HOME}",
    "CARGO_INCREMENTAL": "0",
    "CARGO_NET_OFFLINE": "true",
    "CARGO_PROFILE_DEV_CODEGEN_UNITS": "1",
    "CARGO_PROFILE_TEST_CODEGEN_UNITS": "1",
    "CARGO_TARGET_DIR": "${REPO}/target",
    "HOME": "${USER_HOME}",
    "LC_ALL": "C",
    "PATH": "${TOOLCHAIN}/bin:/usr/bin:/bin",
    "PYTHONDONTWRITEBYTECODE": "1",
    "RUSTC": "${TOOLCHAIN}/bin/rustc",
    "RUSTC_WORKSPACE_WRAPPER": "",
    "RUSTC_WRAPPER": "",
    "RUSTDOC": "${TOOLCHAIN}/bin/rustdoc",
    "RUSTDOCFLAGS": "-Dwarnings",
    "RUSTFLAGS": "-Dwarnings -Funsafe-op-in-unsafe-fn -Ccodegen-units=1",
    "RUST_TEST_THREADS": "1",
    "TMPDIR": "${RAW}/ordinary-fallback/tmp"
  },
  "file_bytes": 134217728,
  "stderr": "${RAW}/ordinary-fallback/stderr.txt",
  "stdout": "${RAW}/ordinary-fallback/stdout.txt",
  "wall_seconds": 90
}
