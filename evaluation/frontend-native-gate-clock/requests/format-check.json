{
  "argv": [
    "${TOOLCHAIN}/bin/cargo",
    "fmt",
    "--manifest-path",
    "${WORKSPACE}/Cargo.toml",
    "--all",
    "--check"
  ],
  "cpu_seconds": 20,
  "cwd": "${WORKSPACE}",
  "env": {
    "CARGO_HOME": "${CARGO_HOME}",
    "HOME": "${USER_HOME}",
    "LC_ALL": "C",
    "PATH": "${TOOLCHAIN}/bin:/usr/bin:/bin",
    "PYTHONDONTWRITEBYTECODE": "1",
    "TMPDIR": "${RAW}/format-check/tmp"
  },
  "file_bytes": 16777216,
  "stderr": "${RAW}/format-check/stderr.txt",
  "stdout": "${RAW}/format-check/stdout.txt",
  "wall_seconds": 30
}
