{
  "argv": [
    "${RUST_TOOLCHAIN}/bin/cargo",
    "fmt",
    "--all",
    "--",
    "--check"
  ],
  "cpu_seconds": 20,
  "cwd": "${REPO}",
  "env": {
    "CARGO_BUILD_JOBS": "4",
    "CARGO_HOME": "${CARGO_HOME}",
    "CARGO_INCREMENTAL": "0",
    "CARGO_NET_OFFLINE": "true",
    "CARGO_PROFILE_DEV_CODEGEN_UNITS": "1",
    "CARGO_PROFILE_TEST_CODEGEN_UNITS": "1",
    "CARGO_TARGET_DIR": "${REPO}/target",
    "HOME": "${USER_HOME}",
    "LC_ALL": "C",
    "PATH": "${RUST_TOOLCHAIN}/bin:/usr/bin:/bin",
    "PYTHONDONTWRITEBYTECODE": "1",
    "RUSTC": "${RUST_TOOLCHAIN}/bin/rustc",
    "RUSTC_WORKSPACE_WRAPPER": "",
    "RUSTC_WRAPPER": "",
    "RUSTDOC": "${RUST_TOOLCHAIN}/bin/rustdoc",
    "RUSTDOCFLAGS": "-Dwarnings",
    "RUSTFLAGS": "-Dwarnings -Funsafe-op-in-unsafe-fn -Ccodegen-units=1",
    "RUST_TEST_THREADS": "1",
    "TMPDIR": "${RAW}/format/tmp"
  },
  "file_bytes": 16777216,
  "stderr": "${RAW}/format/stderr.txt",
  "stdout": "${RAW}/format/stdout.txt",
  "wall_seconds": 30
}
