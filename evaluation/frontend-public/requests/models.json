{
  "argv": [
    "${RAW}/artifacts/model-tests",
    "--test-threads=1",
    "--nocapture"
  ],
  "cpu_seconds": 20,
  "cwd": "${REPO}",
  "env": {
    "HOME": "${USER_HOME}",
    "LC_ALL": "C",
    "PATH": "/usr/bin:/bin",
    "PYTHONDONTWRITEBYTECODE": "1",
    "RUST_TEST_THREADS": "1",
    "TMPDIR": "${RAW}/models/tmp"
  },
  "file_bytes": 1048576,
  "stderr": "${RAW}/models/stderr.txt",
  "stdout": "${RAW}/models/stdout.txt",
  "wall_seconds": 30
}
