{
  "argv": [
    "${TOOLCHAIN}/bin/cargo",
    "test",
    "--manifest-path",
    "${SNAPSHOT}/Cargo.toml",
    "--offline",
    "--locked",
    "--doc",
    "--",
    "--show-output"
  ],
  "cpu_seconds": 20,
  "cwd": "${REPO}",
  "env": {
    "CARGO_BUILD_JOBS": "4",
    "CARGO_HOME": "${CARGO_HOME}",
    "CARGO_INCREMENTAL": "0",
    "CARGO_NET_OFFLINE": "true",
    "CARGO_PROFILE_DEV_CODEGEN_UNITS": "1",
    "CARGO_PROFILE_TEST_CODEGEN_UNITS": "1",
    "CARGO_TARGET_DIR": "${REPO}/target",
    "HOME": "${USER_HOME}",
    "LC_ALL": "C",
    "PATH": "${TOOLCHAIN}/bin:/usr/bin:/bin",
    "PYTHONDONTWRITEBYTECODE": "1",
    "RUSTC": "${TOOLCHAIN}/bin/rustc",
    "RUSTC_WORKSPACE_WRAPPER": "",
    "RUSTC_WRAPPER": "",
    "RUSTDOC": "${TOOLCHAIN}/bin/rustdoc",
    "RUSTDOCFLAGS": "-Dwarnings",
    "RUSTFLAGS": "-Dwarnings -Funsafe-op-in-unsafe-fn -Ccodegen-units=1",
    "RUST_TEST_THREADS": "1",
    "TMPDIR": "${RAW}/tmp"
  },
  "file_bytes": 1048576,
  "stderr": "${RAW}/docs.stderr",
  "stdout": "${RAW}/docs.stdout",
  "wall_seconds": 30
}
