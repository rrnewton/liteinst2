{
  "argv": [
    "${MSRV_TOOLCHAIN}/bin/cargo",
    "check",
    "--manifest-path",
    "${SNAPSHOT}/Cargo.toml",
    "--offline",
    "--locked",
    "--all-targets",
    "--all-features",
    "--message-format=json"
  ],
  "cpu_seconds": 60,
  "cwd": "${REPO}",
  "env": {
    "CARGO_BUILD_JOBS": "4",
    "CARGO_HOME": "${CARGO_HOME}",
    "CARGO_INCREMENTAL": "0",
    "CARGO_NET_OFFLINE": "true",
    "CARGO_PROFILE_DEV_CODEGEN_UNITS": "1",
    "CARGO_PROFILE_TEST_CODEGEN_UNITS": "1",
    "CARGO_TARGET_DIR": "${REPO}/target",
    "HOME": "${USER_HOME}",
    "LC_ALL": "C",
    "PATH": "${MSRV_TOOLCHAIN}/bin:/usr/bin:/bin",
    "PYTHONDONTWRITEBYTECODE": "1",
    "RUSTC": "${MSRV_TOOLCHAIN}/bin/rustc",
    "RUSTC_WORKSPACE_WRAPPER": "",
    "RUSTC_WRAPPER": "",
    "RUSTDOCFLAGS": "-Dwarnings",
    "RUSTFLAGS": "-Dwarnings -Funsafe-op-in-unsafe-fn -Ccodegen-units=1",
    "RUST_TEST_THREADS": "1",
    "TMPDIR": "${RAW}/tmp"
  },
  "file_bytes": 134217728,
  "stderr": "${RAW}/msrv.stderr",
  "stdout": "${RAW}/msrv.stdout",
  "wall_seconds": 90
}
